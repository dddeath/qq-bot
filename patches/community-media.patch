+    def community_entries(self, row):
+        path=self.access.path.parent/'mcp-community.json'
+        if not path.exists():return []
+        config=json.loads(path.read_text('utf-8'))
+        if row['conversation_id'] not in config.get('conversation_ids',[]):return []
+        root=Path(config['directory']).resolve();entries=[]
+        for entry in config.get('items',[]):
+            name=entry['file']
+            if Path(name).name!=name or '/' in name or '\\' in name:continue
+            file=(root/name).resolve()
+            if file.parent!=root or not file.is_file():continue
+            if file.suffix.lower() not in ('.png','.jpg','.jpeg','.gif','.webp'):continue
+            entries.append((entry,file))
+        return entries
+
