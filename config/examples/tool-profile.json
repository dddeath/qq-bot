{
  "kind": "tool_profile",
  "id": "shared-tools",
  "expected_version": 0,
  "body": {
    "servers": {
      "local-knowledge": {
        "command": "/absolute/venv/bin/python",
        "args": [
          "/absolute/release/src/runtime/knowledge_catalog_mcp.py"
        ],
        "env": {
          "QQ_KNOWLEDGE_ROOT": "${knowledge_root}",
          "QQ_KNOWLEDGE_ACCOUNT": "${account_id}",
          "QQ_KNOWLEDGE_GROUP": "${group_id}",
          "QQ_KNOWLEDGE_LEARNING_ROOT": "/absolute/learning"
        },
        "harnesses": [
          "codex",
          "antigravity"
        ],
        "tools": [
          "get_knowledge_index",
          "search_knowledge",
          "read_knowledge"
        ],
        "reading_trace": {
          "root": "/absolute/reading-traces/${account_id}/${group_id}",
          "scope": "qq:${account_id}:group:${group_id}",
          "native_sessions_directory": "/absolute/codex-home/sessions",
          "max_read_units": 10,
          "exploration_budget_ratio": 0.2,
          "timeout_seconds": 300,
          "require_context": false
        }
      }
    }
  }
}
